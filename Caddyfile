# Caddyfile for Already Here Command OS
# Free HTTPS via Let's Encrypt - $0/month
# DOMAIN defaults to alreadyherellc.com; override with: DOMAIN=other.com docker compose up -d

{$DOMAIN:alreadyherellc.com} {
    # Backend API
    handle /api/* {
        reverse_proxy backend:8001
    }

    # Frontend SPA
    handle {
        reverse_proxy frontend:3000
    }

    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    encode gzip

    log {
        output file /var/log/caddy/access.log
        format json
    }
}

# Also handle www subdomain - redirects to apex
www.{$DOMAIN:alreadyherellc.com} {
    redir https://{$DOMAIN:alreadyherellc.com}{uri} permanent
}
