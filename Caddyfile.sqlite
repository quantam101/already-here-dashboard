# Already Here Command OS — SQLite/1GB-RAM build
# Dashboard URL: https://app.alreadyherellc.com
# DNS: A record  app.alreadyherellc.com → 129.146.236.177

app.alreadyherellc.com {
    encode gzip zstd

    # API endpoints reverse-proxy to the FastAPI backend
    handle /api/* {
        reverse_proxy backend:8001
    }

    # Everything else: serve the React build with SPA fallback
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format json
        level INFO
    }
}
